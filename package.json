{
  "name": "vidium-assignment",
  "version": "1.0.0",
  "description": "OrangeHRM BDD Test Automation - Cucumber + Vibium",
  "main": "index.js",
  "type": "commonjs",
  "scripts": {
    "test": "cucumber-js && node utils/reportGenerator.js",
    "test:parallel": "cucumber-js --parallel 2 && node utils/reportGenerator.js",
    "test:smoke": "cucumber-js --tags @smoke && node utils/reportGenerator.js",
    "test:regression": "cucumber-js --tags @regression && node utils/reportGenerator.js",
    "test:sanity": "cucumber-js --tags @sanity && node utils/reportGenerator.js",
    "test:timesheet": "cucumber-js --tags @timesheet && node utils/reportGenerator.js"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@google/generative-ai": "^0.24.1",
    "vibium": "^26.3.17"
  },
  "devDependencies": {
    "@cucumber/cucumber": "^10.3.2",
    "cucumber-html-reporter": "^6.0.0"
  }
}
